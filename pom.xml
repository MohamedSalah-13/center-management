<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.codejava</groupId>
    <artifactId>center-management-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Center Management Platform</name>

    <modules>
        <!--
            ثلاث طبقات، وكلٌّ منها لا ترى ما فوقها:
            center-core   — جافا خالصة: العقود والقرارات الخالصة، بلا Spring ولا JPA ولا JavaFX.
            center-app    — طبقة الأعمال: الكيانات والمستودعات والخدمات، بلا JavaFX في الـ pom.
            center-desktop— تطبيق JavaFX: الشاشات، وتنفيذاتُ عقود النواة على هذا الجهاز.
            وخادم SaaS لاحقاً يستهلك الأولَيْن بسياق طلب مختلف، ولا يرى الثالثة.
        -->
        <module>center-core</module>
        <module>center-app</module>
        <module>center-desktop</module>
    </modules>

    <properties>
        <!-- Spring Boot parent يضبط maven.compiler.release من هذه الخاصية. -->
        <java.version>21</java.version>
        <javafx.version>21.0.2</javafx.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
