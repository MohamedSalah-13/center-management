<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codejava.center.controller.UserManagementController"
      style="-fx-background-color: #f4f6f9; -fx-padding: 30;">

    <Label text="%user.title" textFill="#2c3e50" style="-fx-font-size: 1.86em; -fx-font-weight: bold;"/>

    <!-- نموذج إضافة/تعديل المستخدم -->
    <GridPane hgap="20.0" vgap="15.0" styleClass="card">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            <ColumnConstraints halignment="RIGHT" minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label text="%user.username" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="usernameField" promptText="%user.usernamePrompt" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="%user.role" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="roleCombo" promptText="%user.rolePrompt" maxWidth="Infinity" styleClass="combo-box" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="%user.password" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <PasswordField fx:id="passwordField" promptText="%user.passwordPrompt" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="%user.passwordConfirmation" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <PasswordField fx:id="passwordConfirmationField" promptText="%user.passwordConfirmationPrompt"
                       styleClass="text-field" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <HBox alignment="CENTER_LEFT" spacing="15.0" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3" style="-fx-padding: 10 0 0 0;">
            <Button text="%common.saveNew" onAction="#handleSaveAction" styleClass="button, btn-success" />
            <Button fx:id="updateButton" text="%common.edit" disable="true" onAction="#handleUpdateAction" styleClass="button, btn-warning" />
            <Button fx:id="deleteButton" text="%common.delete" disable="true" onAction="#handleDeleteAction" styleClass="button, btn-danger" />
            <Button text="%common.clearSelection" onAction="#clearForm" styleClass="button, btn-secondary" />
        </HBox>

        <Label fx:id="protectionLabel" styleClass="muted-text"
               visible="false" managed="false" wrapText="true"
               GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3" />
    </GridPane>

    <!-- جدول المستخدمين -->
    <VBox VBox.vgrow="ALWAYS" spacing="10.0" styleClass="card">
        <Label text="%user.registered" style="-fx-font-size: 1.14em; -fx-font-weight: bold;"/>
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId" text="%user.col.id" prefWidth="50.0" />
                <TableColumn fx:id="colUsername" text="%user.col.username" prefWidth="250.0" />
                <TableColumn fx:id="colRole" text="%user.col.role" prefWidth="200.0" />
            </columns>
        </TableView>
    </VBox>
</VBox>
