<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codejava</groupId>
        <artifactId>center-management-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>center-management</artifactId>
    <name>Center Management Desktop</name>

    <!--
        تطبيق JavaFX: الشاشات، وتنفيذاتُ عقود النواة على هذا الجهاز. طبقةُ الأعمال كلها
        تأتي من center-app، ومعها Spring وJPA وجاسبر وFlyway بالتبعية — فلا تُعاد هنا.
        اسم القطعة يبقى center-management لأن اسم ملف الـ jar مكتوب في سكربت التغليف.

        كل الاعتمادات تأتي من Maven Central. لا مستودعات إضافية ولا جرّات مُدرجة في
        المستودع: كانت fx-commons تُستورد من مجلد lib عبر مستودع file://، ثم لم يبقَ منها
        مستعملاً سوى ثلاث دوال صغيرة، فانتقلت إلى util/Forms.java وحُذفت المكتبة كلها.
    -->
    <dependencies>
        <!-- طبقة الأعمال، ومعها النواة وSpring وJPA وجاسبر بالتبعية -->
        <dependency>
            <groupId>com.codejava</groupId>
            <artifactId>center-app</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- الاختبارات: ربط FXML بالمتحكّمات، وحزم النصوص، وإقلاع السياق كاملاً -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
