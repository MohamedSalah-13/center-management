                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SCOPE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="520" y="54" width="35" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="a8100000-0000-4000-8000-000000000001"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_SERIAL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="310" y="54" width="210" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="a8100000-0000-4000-8000-000000000002"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="190" y="54" width="120" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="a8100000-0000-4000-8000-000000000003"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_SUBJECT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="90" y="54" width="100" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="a8100000-0000-4000-8000-000000000004"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_TYPE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="54" width="90" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="a8100000-0000-4000-8000-000000000005"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_VALUE}]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>

