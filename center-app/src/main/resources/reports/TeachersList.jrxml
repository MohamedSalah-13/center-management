<?xml version="1.0" encoding="UTF-8"?>
<!--
  كشف المعلمين كما تعرضهم الشاشة بعد التصفية.

  وصف التصفية يُطبع تحت العنوان ويتكرّر مع columnHeader في رأس كل صفحة: كشف يقول
  "المادة: رياضيات، نوع العمولة: نسبة مئوية" يُقرأ بعد شهر، وكشف بلا وصف يبدو أنه كل
  معلمي السنتر وليس كذلك - وورقة ثانية بلا الوصف تبدو كشفاً آخر.

  ترويسة السنتر في pageHeader عبر التقرير الفرعي الموحّد: راجع
  ReportService.withCenterHeader. والأعمدة من اليمين إلى اليسار: المسلسل ثم الاسم في
  أقصى اليمين، وهو ما يُبحث عنه في الورقة.

  الأعمدة هي أعمدة الجدول على الشاشة نفسها وبعناوينها نفسها (teacher.col.*): الورقة نسخة
  ممّا كان أمام المستخدم لحظة ضغط الزرّ، لا ترتيب آخر يحتاج أن يُقرأ من جديد.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TeachersList" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="NoDataSection"
              uuid="a7b8c9d0-e1f2-4a3b-8c4d-5e6f7a8b9c0d">

    <!-- ترويسة السنتر الموحّدة: يملؤها ReportService.withCenterHeader -->
    <parameter name="HEADER_REPORT" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
    <parameter name="SHOW_CENTER" class="java.lang.Boolean"/>
    <parameter name="CENTER_NAME" class="java.lang.String"/>
    <parameter name="CENTER_PHONE" class="java.lang.String"/>
    <parameter name="LOGO_PATH" class="java.lang.String"/>

    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="SCOPE" class="java.lang.String"/>

    <parameter name="COL_SERIAL" class="java.lang.String"/>
    <parameter name="COL_NAME" class="java.lang.String"/>
    <parameter name="COL_SUBJECT" class="java.lang.String"/>
    <parameter name="COL_TYPE" class="java.lang.String"/>
    <parameter name="COL_VALUE" class="java.lang.String"/>

    <parameter name="PRINTED_AT" class="java.lang.String"/>
    <parameter name="PAGE_LABEL" class="java.lang.String"/>
    <parameter name="NO_ROWS" class="java.lang.String"/>

    <field name="serial" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="subject" class="java.lang.String"/>
    <field name="commissionType" class="java.lang.String"/>
    <field name="commissionValue" class="java.lang.String"/>

    <pageHeader>
        <band height="78" splitType="Prevent">
            <printWhenExpression><![CDATA[$P{SHOW_CENTER}]]></printWhenExpression>
            <subreport>
                <reportElement x="0" y="0" width="555" height="70" uuid="a7000000-0000-4000-8000-000000000001"/>
                <subreportParameter name="CENTER_NAME">
                    <subreportParameterExpression><![CDATA[$P{CENTER_NAME}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="CENTER_PHONE">
                    <subreportParameterExpression><![CDATA[$P{CENTER_PHONE}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="LOGO_PATH">
                    <subreportParameterExpression><![CDATA[$P{LOGO_PATH}]]></subreportParameterExpression>
                </subreportParameter>
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.JREmptyDataSource(1)]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{HEADER_REPORT}]]></subreportExpression>
            </subreport>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="84" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="555" height="26" forecolor="#22303F" uuid="a8000000-0000-4000-8000-000000000001"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
