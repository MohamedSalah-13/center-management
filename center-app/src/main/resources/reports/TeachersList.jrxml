                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{PAGE_LABEL} + " " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- تصفية لا تُطابق شيئاً ورقةٌ تقول ذلك ومعها وصف التصفية: الورقة الفارغة
         تُقرأ كعطل، ولا تقول للقارئ أنه صفّى على مادة لا معلّم لها -->
    <noData>
        <band height="200" splitType="Stretch">
            <subreport>
                <reportElement x="0" y="0" width="555" height="70" uuid="ab000000-0000-4000-8000-000000000000">
                    <printWhenExpression><![CDATA[$P{SHOW_CENTER}]]></printWhenExpression>
                </reportElement>
                <subreportParameter name="CENTER_NAME">
                    <subreportParameterExpression><![CDATA[$P{CENTER_NAME}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="CENTER_PHONE">
                    <subreportParameterExpression><![CDATA[$P{CENTER_PHONE}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="LOGO_PATH">
                    <subreportParameterExpression><![CDATA[$P{LOGO_PATH}]]></subreportParameterExpression>
                </subreportParameter>
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.JREmptyDataSource(1)]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{HEADER_REPORT}]]></subreportExpression>
            </subreport>

            <textField>
                <reportElement x="0" y="86" width="555" height="26" forecolor="#22303F" uuid="ab000000-0000-4000-8000-000000000002"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="116" width="555" height="20" forecolor="#22303F" uuid="ab000000-0000-4000-8000-000000000003"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SCOPE}]]></textFieldExpression>
