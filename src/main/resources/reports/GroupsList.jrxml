                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SCOPE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="420" y="54" width="135" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="d2100000-0000-4000-8000-000000000001"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="54" width="80" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="d2100000-0000-4000-8000-000000000002"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_TEACHER}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="260" y="54" width="80" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="d2100000-0000-4000-8000-000000000003"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_LEVEL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="54" width="100" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="d2100000-0000-4000-8000-000000000004"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_DAYS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="85" y="54" width="75" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="d2100000-0000-4000-8000-000000000005"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_TIME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="54" width="45" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="d2100000-0000-4000-8000-000000000006"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_MEMBERS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="54" width="40" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="d2100000-0000-4000-8000-000000000007"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_PRICE}]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>

    <detail>
        <band height="30" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="30" backcolor="#FAFBFD" mode="Opaque"
                              uuid="d3000000-0000-4000-8000-000000000000">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <textField isStretchWithOverflow="true">
                <reportElement x="420" y="0" width="135" height="30" uuid="d3100000-0000-4000-8000-000000000001"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="340" y="0" width="80" height="30" uuid="d3100000-0000-4000-8000-000000000002"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
