                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{level}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="160" y="0" width="100" height="30" uuid="d3100000-0000-4000-8000-000000000004"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{days}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="85" y="0" width="75" height="30" uuid="d3100000-0000-4000-8000-000000000005"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{time}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="45" height="30" uuid="d3100000-0000-4000-8000-000000000006"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{members}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="0" width="40" height="30" uuid="d3100000-0000-4000-8000-000000000007"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{price}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="26" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#E3E8EF" uuid="d4000000-0000-4000-8000-000000000001"/>
            </line>
            <textField>
                <reportElement x="0" y="6" width="300" height="18" forecolor="#7B8A9A" uuid="d4000000-0000-4000-8000-000000000002"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{PRINTED_AT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="6" width="200" height="18" forecolor="#7B8A9A" uuid="d4000000-0000-4000-8000-000000000003"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{PAGE_LABEL} + " " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
