<?xml version="1.0" encoding="UTF-8"?>
<!--
  جرد الوردية على الرول، لا على A4.

  هذا هو المطبوع الذي يُقصّ عند تقفيل الدرج ويُدبَّس على النقد المسلَّم، فمكانه رول
  الكاشير حيث هو واقف - لا طابعة A4 في مكتب الإدارة. ولذلك يمرّ بـ DocumentKind.RECEIPT:
  طابعته وورقه غير طابعة التقارير وورقها في PrintPreferences.

  isIgnorePagination: ورقة واحدة مهما طال تفصيل الحركات، تُقصّ عند آخر سطر. ولا ترقيم
  صفحات على رول لا صفحات له.

  الملخّص فوق التفصيل عن قصد: صافي الدرج هو ما يُقارَن بما في اليد، وقد يكون تحته أربعون
  حركة. من يبحث عن الرقم لا ينبغي أن يلفّ الرول.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ShiftSummary" pageWidth="227" pageHeight="842" columnWidth="211"
              leftMargin="8" rightMargin="8" topMargin="8" bottomMargin="8"
              isIgnorePagination="true" whenNoDataType="AllSectionsNoDetail"
              uuid="b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e">

    <parameter name="HEADER_REPORT" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
    <parameter name="SHOW_CENTER" class="java.lang.Boolean"/>
    <parameter name="CENTER_NAME" class="java.lang.String"/>
    <parameter name="CENTER_PHONE" class="java.lang.String"/>
    <parameter name="LOGO_PATH" class="java.lang.String"/>

    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="INCOME_LINE" class="java.lang.String"/>
    <parameter name="EXPENSES_LINE" class="java.lang.String"/>
    <parameter name="PAYOUTS_LINE" class="java.lang.String"/>
    <parameter name="NET_LINE" class="java.lang.String"/>
    <parameter name="DETAILS_TITLE" class="java.lang.String"/>
    <parameter name="PRINTED_AT" class="java.lang.String"/>

    <field name="time" class="java.lang.String"/>
    <field name="amount" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>

    <!-- كل ما يُطبع مرة واحدة في title لا في pageHeader: إلغاء الصفحات يُسقط ترويسة
         الصفحة وذيلها معاً، فوضع الملخّص فيها كان سيمحوه من الورقة بلا خطأ يُعلن -->
    <title>
        <band height="48" splitType="Stretch">
            <subreport>
                <reportElement x="0" y="0" width="211" height="48" uuid="b2000000-0000-4000-8000-000000000001">
                    <printWhenExpression><![CDATA[$P{SHOW_CENTER}]]></printWhenExpression>
                </reportElement>
                <subreportParameter name="CENTER_NAME">
                    <subreportParameterExpression><![CDATA[$P{CENTER_NAME}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="CENTER_PHONE">
                    <subreportParameterExpression><![CDATA[$P{CENTER_PHONE}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="LOGO_PATH">
                    <subreportParameterExpression><![CDATA[$P{LOGO_PATH}]]></subreportParameterExpression>
                </subreportParameter>
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.JREmptyDataSource(1)]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{HEADER_REPORT}]]></subreportExpression>
            </subreport>

        </band>
    </title>

    <!-- الملخّص في columnHeader لا في title: التقرير الفرعي فوقه يتمدّد بالشعار،
         والعناصر في فرقة واحدة مواضعها مطلقة فلا تنزاح معه - فتقع تحته أو فوقه -->
    <columnHeader>
        <band height="150" splitType="Stretch">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="211" height="22" uuid="b3000000-0000-4000-8000-000000000001"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="28" width="211" height="16" uuid="b3000000-0000-4000-8000-000000000002"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{INCOME_LINE}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="46" width="211" height="16" uuid="b3000000-0000-4000-8000-000000000003"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{EXPENSES_LINE}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="64" width="211" height="16" uuid="b3000000-0000-4000-8000-000000000004"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{PAYOUTS_LINE}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="86" width="211" height="1" uuid="b3000000-0000-4000-8000-000000000005"/>
                <graphicElement><pen lineWidth="0.5" lineStyle="Dashed"/></graphicElement>
            </line>

            <!-- صافي الدرج: الرقم الذي يُعدّ النقد في اليد مقابله -->
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="92" width="211" height="24" uuid="b3000000-0000-4000-8000-000000000006"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{NET_LINE}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="122" width="211" height="1" uuid="b3000000-0000-4000-8000-000000000007"/>
                <graphicElement><pen lineWidth="0.5" lineStyle="Dashed"/></graphicElement>
            </line>

            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="128" width="211" height="18" uuid="b3000000-0000-4000-8000-000000000008"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{DETAILS_TITLE}]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Stretch">
            <textField>
                <reportElement x="156" y="0" width="55" height="16" uuid="b4000000-0000-4000-8000-000000000001"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="ArabicFont" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{time}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="56" y="0" width="100" height="16" uuid="b4000000-0000-4000-8000-000000000002"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="0" width="56" height="16" uuid="b4000000-0000-4000-8000-000000000003"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="ArabicFont" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="34" splitType="Stretch">
            <line>
                <reportElement x="0" y="4" width="211" height="1" uuid="b5000000-0000-4000-8000-000000000001"/>
                <graphicElement><pen lineWidth="0.5" lineStyle="Dashed"/></graphicElement>
            </line>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="10" width="211" height="16" uuid="b5000000-0000-4000-8000-000000000002"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{PRINTED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
