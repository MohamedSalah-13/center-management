<?xml version="1.0" encoding="UTF-8"?>
<!--
  كشف اشتراكات طالب.

  لا نصّ عربياً واحداً في هذا الملف: كل ما يُقرأ يصل معاملاً من الجافا عبر I18n، لأن
  الملف لا تراه حزم النصوص ولا يفحصه MessageBundleTest، فنصٌّ مكتوب هنا يعني كشفاً
  عربياً يخرج لمستخدم ضبط برنامجه على الإنجليزية - وهو أول ما نسيه الكشفان السابقان.

  والأعمدة مرصوصة من اليمين إلى اليسار (المجموعة في أقصى اليمين): جاسبر يرصّ الأعمدة
  بإحداثيات ثابتة ولا يعكسها باللغة كما تفعل الواجهة، والسنتر عربي - فهذا هو الترتيب
  الذي يُقرأ، وكل عمود يحمل عنوانه فوقه على أي حال.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="StudentEnrollments" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="NoDataSection"
              uuid="c7d8e9fa-0b1c-2d3e-4f5a-6b7c8d9e0f1a">

    <!-- ترويسة السنتر -->
    <parameter name="CENTER_NAME" class="java.lang.String"/>
    <parameter name="CENTER_PHONE" class="java.lang.String"/>

    <!-- عنوان الكشف وموضوعه -->
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="STUDENT_NAME" class="java.lang.String"/>
    <parameter name="STUDENT_DETAILS" class="java.lang.String"/>
    <parameter name="SUMMARY" class="java.lang.String"/>

    <!-- عناوين الأعمدة: هي نفسها عناوين الجدول على الشاشة -->
    <parameter name="COL_GROUP" class="java.lang.String"/>
    <parameter name="COL_JOINED" class="java.lang.String"/>
    <parameter name="COL_LEFT" class="java.lang.String"/>
    <parameter name="COL_HELD" class="java.lang.String"/>
    <parameter name="COL_ATTENDED" class="java.lang.String"/>
    <parameter name="COL_RATE" class="java.lang.String"/>

    <parameter name="PRINTED_AT" class="java.lang.String"/>
    <parameter name="PAGE_LABEL" class="java.lang.String"/>
    <parameter name="NO_ROWS" class="java.lang.String"/>

    <field name="groupName" class="java.lang.String"/>
    <field name="joinDate" class="java.lang.String"/>
    <field name="leaveDate" class="java.lang.String"/>
    <field name="sessionsHeld" class="java.lang.String"/>
    <field name="sessionsAttended" class="java.lang.String"/>
    <field name="attendanceRate" class="java.lang.String"/>

    <title>
        <band height="150" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="555" height="30" forecolor="#22303F" uuid="1a000000-0000-4000-8000-000000000001"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTER_NAME}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="30" width="555" height="16" forecolor="#7B8A9A" uuid="1a000000-0000-4000-8000-000000000002"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTER_PHONE}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="50" width="555" height="1" forecolor="#E3E8EF" uuid="1a000000-0000-4000-8000-000000000003"/>
            </line>

            <textField>
                <reportElement x="0" y="58" width="555" height="24" forecolor="#22303F" uuid="1a000000-0000-4000-8000-000000000004"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="88" width="555" height="20" forecolor="#22303F" uuid="1a000000-0000-4000-8000-000000000005"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{STUDENT_NAME}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="108" width="555" height="18" forecolor="#7B8A9A" uuid="1a000000-0000-4000-8000-000000000006"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{STUDENT_DETAILS}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="126" width="555" height="18" forecolor="#22303F" uuid="1a000000-0000-4000-8000-000000000007"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="ArabicFont" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SUMMARY}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="28" splitType="Stretch">
            <textField>
                <reportElement x="385" y="0" width="170" height="28" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="2a000000-0000-4000-8000-000000000001"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_GROUP}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="295" y="0" width="90" height="28" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="2a000000-0000-4000-8000-000000000002"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_JOINED}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="205" y="0" width="90" height="28" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="2a000000-0000-4000-8000-000000000003"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_LEFT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="125" y="0" width="80" height="28" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="2a000000-0000-4000-8000-000000000004"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_HELD}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="55" y="0" width="70" height="28" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="2a000000-0000-4000-8000-000000000005"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_ATTENDED}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="0" width="55" height="28" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="2a000000-0000-4000-8000-000000000006"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_RATE}]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>

    <detail>
        <band height="26" splitType="Stretch">
            <!-- تلوين الصفوف الفردية: صفٌّ من ستة أرقام بلا خلفية متبادلة تُقرأ سطوره مزاحة -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="26" backcolor="#FAFBFD" mode="Opaque"
                              uuid="3a000000-0000-4000-8000-000000000000">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <textField isStretchWithOverflow="true">
                <reportElement x="385" y="0" width="170" height="26" uuid="3a000000-0000-4000-8000-000000000001"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{groupName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="295" y="0" width="90" height="26" uuid="3a000000-0000-4000-8000-000000000002"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{joinDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="205" y="0" width="90" height="26" uuid="3a000000-0000-4000-8000-000000000003"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{leaveDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="125" y="0" width="80" height="26" uuid="3a000000-0000-4000-8000-000000000004"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{sessionsHeld}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="55" y="0" width="70" height="26" uuid="3a000000-0000-4000-8000-000000000005"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{sessionsAttended}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="0" width="55" height="26" uuid="3a000000-0000-4000-8000-000000000006"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{attendanceRate}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="26" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#E3E8EF" uuid="4a000000-0000-4000-8000-000000000001"/>
            </line>
            <textField>
                <reportElement x="0" y="6" width="300" height="18" forecolor="#7B8A9A" uuid="4a000000-0000-4000-8000-000000000002"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{PRINTED_AT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="6" width="200" height="18" forecolor="#7B8A9A" uuid="4a000000-0000-4000-8000-000000000003"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{PAGE_LABEL} + " " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- طالب بلا اشتراك ورقةٌ تقول ذلك، لا ورقة فارغة تُقرأ كعطل في الطباعة -->
    <noData>
        <band height="180" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="555" height="30" forecolor="#22303F" uuid="5a000000-0000-4000-8000-000000000001"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="20" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{CENTER_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="45" width="555" height="24" forecolor="#22303F" uuid="5a000000-0000-4000-8000-000000000002"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="75" width="555" height="20" forecolor="#22303F" uuid="5a000000-0000-4000-8000-000000000003"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{STUDENT_NAME}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="105" width="555" height="20" forecolor="#7B8A9A" uuid="5a000000-0000-4000-8000-000000000004"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{NO_ROWS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="140" width="555" height="18" forecolor="#7B8A9A" uuid="5a000000-0000-4000-8000-000000000005"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{PRINTED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </noData>

</jasperReport>
