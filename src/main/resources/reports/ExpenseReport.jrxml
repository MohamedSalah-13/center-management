            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="520" y="0" width="35" height="26" uuid="66778899-0000-4000-8000-300000000004"/>
                <box><topPen lineWidth="0.25" lineColor="#E3E8EF"/><leftPen lineWidth="0.25" lineColor="#E3E8EF"/><bottomPen lineWidth="0.25" lineColor="#E3E8EF"/><rightPen lineWidth="0.25" lineColor="#E3E8EF"/></box>
