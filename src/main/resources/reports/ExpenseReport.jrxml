                </textElement>
                <textFieldExpression><![CDATA[$P{SCOPE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="50" width="100" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="66778899-0000-4000-8000-200000000000"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_AMOUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="50" width="280" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="66778899-0000-4000-8000-200000000001"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_DESCRIPTION}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="50" width="70" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="66778899-0000-4000-8000-200000000002"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_TIME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="450" y="50" width="70" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="66778899-0000-4000-8000-200000000003"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="ArabicFont" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COL_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="520" y="50" width="35" height="30" backcolor="#22303F" forecolor="#FFFFFF" mode="Opaque" uuid="66778899-0000-4000-8000-200000000004"/>
                <box><topPen lineWidth="0.5" lineColor="#22303F"/><leftPen lineWidth="0.5" lineColor="#22303F"/><bottomPen lineWidth="0.5" lineColor="#22303F"/><rightPen lineWidth="0.5" lineColor="#22303F"/></box>
