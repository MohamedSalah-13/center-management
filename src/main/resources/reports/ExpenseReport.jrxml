            </line>
            <textField>
                <reportElement x="0" y="6" width="300" height="18" forecolor="#7B8A9A" uuid="66778899-0000-4000-8000-800000000002"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
