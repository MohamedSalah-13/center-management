            </textField>
            <textField>
                <reportElement x="355" y="6" width="200" height="18" forecolor="#7B8A9A" uuid="66778899-0000-4000-8000-800000000003"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="ArabicFont" size="9"/></textElement>
