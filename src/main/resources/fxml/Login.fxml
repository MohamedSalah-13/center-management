<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codejava.center.controller.LoginController">

    <VBox alignment="CENTER" spacing="15.0" styleClass="card" maxWidth="400.0">
        <Label text="%login.title" styleClass="header-label">
            <VBox.margin><Insets bottom="10.0" /></VBox.margin>
        </Label>

        <TextField fx:id="usernameField" promptText="%login.username" styleClass="text-field" />
        <PasswordField fx:id="passwordField" promptText="%login.password" styleClass="text-field" />

        <Label fx:id="errorLabel" styleClass="danger-text" visible="false" wrapText="true" />

        <Button text="%login.submit" onAction="#handleLogin" defaultButton="true" maxWidth="Infinity" styleClass="button" />
    </VBox>

    <!-- مبدّل اللغة هنا لا في الإعدادات: شاشة الإعدادات للمدير وحده،
         وأول ما يحتاج المشغّل رؤيته بلغته هو شاشة الدخول نفسها.
         وحجم الخط معه للسبب نفسه: من لا يقرأ هذه الشاشة لا يصل إلى ما بعدها -->
    <HBox alignment="CENTER" spacing="10.0">
        <Label text="%common.language" styleClass="muted-text"/>
        <ComboBox fx:id="languageCombo" prefWidth="140.0"/>
        <Label text="%common.fontSize" styleClass="muted-text"/>
        <ComboBox fx:id="fontScaleCombo" prefWidth="100.0"/>
    </HBox>
</VBox>
