<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codejava.center.controller.StudentRegistrationController"
      style="-fx-background-color: #f4f4f4; -fx-padding: 30;">

    <Label text="%student.title" textFill="#2c3e50" style="-fx-font-size: 1.71em; -fx-font-weight: bold;"/>

    <GridPane hgap="15.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" />
        </columnConstraints>

        <Label text="%student.name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="%student.phone" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="%student.parentPhone" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="parentPhoneField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="%student.level" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="schoolLevelCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="%student.barcode" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="barcodeField" promptText="%student.barcodePrompt" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button text="%common.saveNew" onAction="#handleSaveAction" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
        <Button fx:id="updateButton" text="%common.edit" disable="true" onAction="#handleUpdateAction" style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
        <Button fx:id="deleteButton" text="%common.delete" disable="true" onAction="#handleDeleteAction" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
        <Button text="%common.clearSelection" onAction="#handleClearAction" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
        <Button text="%student.exportIdCards" onAction="#handleExportIdCards" style="-fx-background-color: #8e44ad; -fx-text-fill: white;" />
    </HBox>

    <!-- تصفية جدول الطلاب: نصّ حر ومرحلة دراسية -->
    <FlowPane hgap="12.0" vgap="10.0" style="-fx-padding: 0 0 10 0;">
        <Label text="%student.searchLabel" />
        <TextField fx:id="searchField" promptText="%student.searchPrompt" prefWidth="300.0" styleClass="text-field" />
        <Label text="%student.filterLevel" />
        <ComboBox fx:id="levelFilterCombo" prefWidth="180.0" />
        <Label fx:id="resultCountLabel" textFill="#7f8c8d" />
    </FlowPane>

    <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colBarcode" text="%student.col.barcode" prefWidth="120.0" />
            <TableColumn fx:id="colName" text="%student.col.name" prefWidth="250.0" />
            <TableColumn fx:id="colPhone" text="%student.col.phone" prefWidth="120.0" />
            <TableColumn fx:id="colLevel" text="%student.col.level" prefWidth="150.0" />
            <TableColumn fx:id="colEnrollments" text="%student.col.enrollments" prefWidth="140.0" sortable="false" />
        </columns>
    </TableView>
</VBox>
