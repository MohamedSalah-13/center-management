<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<!-- لا nodeOrientation هنا: الاتجاه يُضبط على الـ Scene في ViewLoader تبعاً للغة،
     وتثبيته في FXML كان يفرض اليمين-لليسار حتى على الواجهة الإنجليزية -->
<BorderPane prefHeight="768.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.codejava.center.controller.DashboardController"
            stylesheets="@../css/style.css">

    <!-- القائمة الجانبية: ترويسة ثابتة + تنقّل قابل للتمرير + خروج ثابت أسفل.
         التمرير ضروري لأن عدد الشاشات تجاوز ارتفاع النافذة فكانت الأزرار الأخيرة تُقصّ. -->
    <!-- لا prefWidth هنا: العرض في style.css بالـ em ليتبع حجم الخط، وقيمة مكتوبة
         في FXML تُعدّ ضبطاً من المستخدم فلا يعلوها التنسيق ولا تكبر مع أزرارها -->
    <left>
        <VBox styleClass="sidebar" BorderPane.alignment="CENTER">

            <VBox alignment="CENTER" spacing="8" styleClass="sidebar-header">
                <padding><Insets top="22.0" bottom="16.0" left="12.0" right="12.0"/></padding>

                <!-- الشعار المحفوظ في الإعدادات كان يظهر في المطبوعات فقط، وتبقى هنا
                     دائرة رمادية ثابتة. الدائرة الآن بديل يظهر حين لا شعار أو تعذّر تحميله. -->
                <StackPane>
                    <Circle fx:id="logoPlaceholder" radius="28" fill="#ecf0f1"/>
                    <ImageView fx:id="centerLogoView" fitWidth="200.0" fitHeight="64.0"
                               preserveRatio="true" visible="false" managed="false"/>
                </StackPane>
                <!-- minHeight="-Infinity" هو USE_PREF_SIZE: بدونه يحسب الـ VBox أدنى ارتفاع
                     للعنوان بسطر واحد فيقصّ الاسم الطويل بثلاث نقاط بدل أن يلتفّ.
                     ظهر ذلك مع الإنجليزية لأن اسمها الافتراضي أطول من العربي. -->
                <Label fx:id="centerNameLabel" text="%app.title" styleClass="sidebar-title"
                       wrapText="true" textAlignment="CENTER" maxWidth="230" minHeight="-Infinity"/>
                <HBox alignment="CENTER" spacing="6">
                    <Label fx:id="userNameLabel" text="%common.empty" styleClass="sidebar-user"/>
                    <Label fx:id="userRoleLabel" text="" styleClass="sidebar-role"/>
                </HBox>

                <!-- الجرس: العدّاد وقائمة ما لم يُعالَج. مخفيّ لغير المدير لأن
                     صندوق التنبيهات نفسه مقصور عليه. -->
                <Button fx:id="bellButton" text="%alerts.bell" onAction="#showAlertDropdown"
                        styleClass="bell-btn" visible="false" managed="false"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="sidebar-scroll"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox spacing="4.0">
                    <padding><Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/></padding>

                    <VBox fx:id="navDailyBox" spacing="3.0">
                        <Label text="%nav.section.daily" styleClass="sidebar-section"/>
                        <Button fx:id="homeButton" text="%nav.home" onAction="#showHome"
                                maxWidth="Infinity" styleClass="sidebar-btn, sidebar-btn-active"/>
                        <Button fx:id="studentsButton" text="%nav.students" onAction="#showStudentRegistration"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="attendanceButton" text="%nav.attendance" onAction="#showAttendance"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="sessionsButton" text="%nav.sessions" onAction="#showSessionManagement"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="dayScheduleButton" text="%nav.daySchedule" onAction="#showDaySchedule"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                    </VBox>

                    <VBox fx:id="navFinanceBox" spacing="3.0">
                        <Label text="%nav.section.finance" styleClass="sidebar-section"/>
                        <Button fx:id="cashierButton" text="%nav.cashier" onAction="#showCashier"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="paymentHistoryButton" text="%nav.paymentHistory" onAction="#showPaymentHistory"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="expensesButton" text="%nav.expenses" onAction="#showExpenses"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="shiftClosingButton" text="%nav.shiftClosing" onAction="#showShiftClosing"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="teacherPayoutButton" text="%nav.teacherPayout"
                                onAction="#showTeacherPayout" maxWidth="Infinity" styleClass="sidebar-btn"/>
                    </VBox>

                    <VBox fx:id="navReportsBox" spacing="3.0">
                        <Label text="%nav.section.reports" styleClass="sidebar-section"/>
                        <Button fx:id="attendanceReportButton" text="%nav.attendanceReport"
                                onAction="#showAttendanceReport" maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="arrearsButton" text="%nav.arrears" onAction="#showArrears"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="notificationsButton" text="%nav.notifications"
                                onAction="#showNotifications" maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="alertsButton" text="%nav.alerts" onAction="#showAlerts"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                    </VBox>

                    <VBox fx:id="navAdminBox" spacing="3.0">
                        <Label text="%nav.section.admin" styleClass="sidebar-section"/>
                        <Button fx:id="teachersButton" text="%nav.teachers" onAction="#showTeachers"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="groupsButton" text="%nav.groups" onAction="#showGroups"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="usersManagementButton" text="%nav.users" onAction="#showUsers"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="auditButton" text="%nav.audit" onAction="#showAuditLog"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                        <Button fx:id="settingsButton" text="%nav.settings" onAction="#showSettings"
                                maxWidth="Infinity" styleClass="sidebar-btn"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="10.0">
                <padding><Insets top="10.0" bottom="14.0" left="12.0" right="12.0"/></padding>

                <!-- اللغة متاحة لكل الأدوار: تفضيل عرض على هذا الجهاز، لا إعداد إداري -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="%common.language" styleClass="sidebar-role"/>
                    <ComboBox fx:id="languageCombo" styleClass="sidebar-combo"
                              maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- وحجم الخط كذلك: شاشة الإعدادات للمدير وحده، ومن يقضي يومه أمام
                     شاشة الاستقبال هو أول من يحتاج تكبير ما يقرأه -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="%common.fontSize" styleClass="sidebar-role"/>
                    <ComboBox fx:id="fontScaleCombo" styleClass="sidebar-combo"
                              maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Button text="%nav.logout" onAction="#handleLogout"
                        maxWidth="Infinity" styleClass="sidebar-btn, sidebar-btn-logout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" BorderPane.alignment="CENTER" styleClass="content-area">
            <ScrollPane fx:id="homeScroll" fitToWidth="true" styleClass="content-scroll" hbarPolicy="NEVER">
                <VBox fx:id="homeView" spacing="24.0">
                    <padding><Insets top="30.0" bottom="30.0" left="32.0" right="32.0"/></padding>

                    <Label text="%home.title" styleClass="header-label" />

                    <HBox spacing="20.0" alignment="CENTER_LEFT">
                        <VBox styleClass="stat-card, card-blue" HBox.hgrow="ALWAYS">
                            <Label text="%home.totalStudents" styleClass="stat-caption"/>
                            <Label fx:id="totalStudentsLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox fx:id="revenueCard" styleClass="stat-card, card-green" HBox.hgrow="ALWAYS">
                            <Label text="%home.dailyRevenue" styleClass="stat-caption"/>
                            <Label fx:id="dailyRevenueLabel" text="%common.empty" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card, card-orange" HBox.hgrow="ALWAYS">
                            <Label text="%home.activeSessions" styleClass="stat-caption"/>
                            <Label fx:id="activeSessionsLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="20.0" VBox.vgrow="ALWAYS" alignment="CENTER">
                        <VBox fx:id="revenueChartCard" styleClass="card" HBox.hgrow="ALWAYS"
                              prefWidth="420" minHeight="340">
                            <PieChart fx:id="revenuePieChart" title="%home.revenueChart"
                                      legendSide="BOTTOM" animated="false" VBox.vgrow="ALWAYS"/>
                        </VBox>

                        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="520" minHeight="340">
                            <BarChart fx:id="attendanceBarChart" title="%home.attendanceChart"
                                      animated="false" legendVisible="false" VBox.vgrow="ALWAYS">
                                <xAxis><CategoryAxis label="%home.axis.day" /></xAxis>
                                <yAxis><NumberAxis label="%home.axis.studentCount" /></yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
