<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codejava.center.controller.SettingsController"
      styleClass="content-area">
    <padding><Insets top="28.0" bottom="24.0" left="30.0" right="30.0"/></padding>

    <Label text="%settings.title" styleClass="header-label"/>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- ============ بيانات السنتر ============ -->
        <Tab text="%settings.tab.center">
            <VBox spacing="18.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <Label text="%settings.centerNote" styleClass="muted-text" wrapText="true"/>

                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="320.0" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="120.0"/>
                    </columnConstraints>

                    <Label text="%settings.centerName" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="centerNameField" promptText="%settings.centerNamePrompt"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="%settings.centerPhone" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="centerPhoneField" promptText="%settings.centerPhonePrompt"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="%settings.currency" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="currencyCombo" maxWidth="Infinity"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="%settings.logo" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="logoPathField" promptText="%settings.logoPrompt" editable="false"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Button text="%common.browse" onAction="#handleBrowseLogo" styleClass="btn-secondary"
                            GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                </GridPane>

                <Label text="%settings.currencyNote" styleClass="muted-text" wrapText="true"/>

                <HBox spacing="14.0" alignment="CENTER_RIGHT" styleClass="card">
                    <Label text="%settings.logoPreview" styleClass="sub-label"/>
                    <ImageView fx:id="logoImageView" fitHeight="90.0" preserveRatio="true"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- ============ العرض: اللغة وحجم الخط ============
             الاثنان تفضيلا جهاز لا إعدادَي سنتر، ولهذا هما معاً في تبويب واحد
             ومكرَّران في القائمة الجانبية حيث يصل إليهما كل الأدوار -->
        <Tab text="%settings.tab.display">
            <VBox spacing="18.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="220.0"/>
                    </columnConstraints>

                    <Label text="%settings.language" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="languageCombo" maxWidth="Infinity"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="%settings.fontSize" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="fontScaleCombo" maxWidth="Infinity"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>

                <Label text="%settings.languageNote" styleClass="muted-text" wrapText="true"/>
                <Label text="%settings.fontSizeNote" styleClass="muted-text" wrapText="true"/>
            </VBox>
        </Tab>

        <!-- ============ الطباعة ============ -->
        <Tab text="%settings.tab.print">
            <ScrollPane fitToWidth="true">
                <VBox spacing="16.0">
                    <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="110.0"/>
                        </columnConstraints>

                        <Label text="%settings.printMode" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="printModeCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button text="%common.refresh" onAction="#handleRefreshPrinters" styleClass="btn-secondary"
                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    </GridPane>

                    <Label text="%settings.printModeNote" styleClass="muted-text" wrapText="true"/>

                    <!-- تفضيل ثانٍ لا تكرار للأول: أعلاه مطبوعات البرنامج، وهذا كشوف
                         جاسبر - مسارا طباعة لا يشتركان في سطر، ولذلك جاورا بعضهما بشرحٍ
                         يقول أيّ الكشوف يخصّ -->
                    <CheckBox fx:id="directSheetPrintCheck" text="%settings.printSheetsDirect"/>
                    <Label text="%settings.printSheetsDirectNote" styleClass="muted-text" wrapText="true"/>

                    <CheckBox fx:id="centerHeaderCheck" text="%settings.printCenterHeader"/>
                    <Label text="%settings.printCenterHeaderNote" styleClass="muted-text" wrapText="true"/>

                    <Separator/>

                    <!-- التقارير: ورق مقطوع، تُقسَّم على صفحات -->
                    <Label text="%settings.printReports" styleClass="sub-label"/>

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="110.0"/>
                        </columnConstraints>

                        <Label text="%settings.printer" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="reportPrinterCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="%settings.paper" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="reportPaperCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Button text="%settings.printTestPage" onAction="#handlePrintReportTestPage"
                                styleClass="btn-secondary"
                                GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                        <Label text="%settings.printTarget" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="reportTargetLabel" text="%common.empty" wrapText="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>

                    <Label fx:id="reportWarningLabel" styleClass="danger-text" wrapText="true"
                           visible="false" managed="false"/>

                    <Separator/>

                    <!-- الإيصالات: رول متصل، صفحة واحدة -->
                    <Label text="%settings.printReceipts" styleClass="sub-label"/>

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="110.0"/>
                        </columnConstraints>

                        <Label text="%settings.printer" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="receiptPrinterCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="%settings.paper" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="receiptPaperCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Button text="%settings.printTestReceipt" onAction="#handlePrintReceiptTestPage"
                                styleClass="btn-secondary"
                                GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                        <Label text="%settings.printTarget" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="receiptTargetLabel" text="%common.empty" wrapText="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>

                    <Label fx:id="receiptWarningLabel" styleClass="danger-text" wrapText="true"
                           visible="false" managed="false"/>

                    <Separator/>

                    <Label text="%settings.paperNote" styleClass="muted-text" wrapText="true"/>
                    <Label text="%settings.printNote" styleClass="muted-text" wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ============ الإشعارات ============ -->
        <Tab text="%settings.tab.notifications">
            <ScrollPane fitToWidth="true">
                <VBox spacing="16.0">
                    <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="%settings.notif.channel" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="notifChannelCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="%settings.notif.state" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="notifStateLabel" text="%common.empty" wrapText="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </GridPane>

                    <Label fx:id="notifChannelNoteLabel" styleClass="muted-text" wrapText="true"/>

                    <Separator/>

                    <!-- الرابط: يفتح محادثة على هذا الجهاز، فشكله تفضيل جهاز لا سنتر -->
                    <VBox fx:id="notifLinkBox" spacing="14.0">
                        <Label text="%settings.notif.linkSection" styleClass="sub-label"/>

                        <GridPane hgap="16.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="%settings.notif.linkStyle" styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="notifLinkStyleCombo" maxWidth="Infinity"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label fx:id="notifLinkTemplateLabel" text="%settings.notif.linkTemplate"
                                   styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="notifLinkTemplateField" promptText="%settings.notif.linkTemplatePrompt"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="%settings.notif.linkPreview" styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="notifLinkPreviewLabel" text="%common.empty" wrapText="true"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        </GridPane>

                        <Label text="%settings.notif.linkNote" styleClass="muted-text" wrapText="true"/>
                    </VBox>

                    <!-- المزوّد: إرسال مباشر بلا تدخّل، ومفتاحه يخصّ هذا الجهاز -->
                    <VBox fx:id="notifProviderBox" spacing="14.0">
                        <Label text="%settings.notif.providerSection" styleClass="sub-label"/>

                        <GridPane hgap="16.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="%settings.notif.apiUrl" styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="notifApiUrlField"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="%settings.notif.senderId" styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="notifSenderIdField"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="%settings.notif.token" styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <PasswordField fx:id="notifTokenField" promptText="%settings.notif.tokenPrompt"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label fx:id="notifTemplateNameLabel" text="%settings.notif.templateName"
                                   styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="notifTemplateNameField"
                                       promptText="%settings.notif.templateNamePrompt"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label fx:id="notifTemplateLanguageLabel" text="%settings.notif.templateLanguage"
                                   styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <TextField fx:id="notifTemplateLanguageField"
                                       promptText="%settings.notif.templateLanguagePrompt"
                                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                            <Label fx:id="notifBodyTemplateLabel" text="%settings.notif.bodyTemplate"
                                   styleClass="sub-label"
                                   GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <TextField fx:id="notifBodyTemplateField"
                                       promptText="%settings.notif.bodyTemplatePrompt"
                                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        </GridPane>

                        <Label text="%settings.notif.tokenNote" styleClass="muted-text" wrapText="true"/>
                        <Label fx:id="notifProviderNoteLabel" styleClass="muted-text" wrapText="true"/>
                    </VBox>

                    <Separator/>

                    <!-- الاختبار: مفتاح منتهٍ أو قالب غير معتمَد لا يظهران إلا في ردّ المزوّد -->
                    <Label text="%settings.notif.testSection" styleClass="sub-label"/>

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="110.0"/>
                        </columnConstraints>

                        <Label text="%settings.notif.testPhone" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="notifTestPhoneField" promptText="%settings.notif.testPhonePrompt"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button text="%settings.notif.testSend" onAction="#handleTestNotification"
                                styleClass="btn-secondary"
                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    </GridPane>

                    <Label text="%settings.notif.testNote" styleClass="muted-text" wrapText="true"/>
                    <Label text="%settings.notif.saveNote" styleClass="muted-text" wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ============ النسخ الاحتياطي ============ -->
        <Tab text="%settings.tab.backup">
            <ScrollPane fitToWidth="true">
                <VBox spacing="16.0">
                    <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="110.0"/>
                        </columnConstraints>

                        <Label text="%settings.backupPath" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="backupPathField" promptText="%settings.backupPathPrompt" editable="false"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button text="%common.browse" onAction="#handleBrowseBackupPath" styleClass="btn-secondary"
                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                        <CheckBox fx:id="autoBackupCheckBox" text="%settings.autoBackup"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </GridPane>

                    <Separator/>

                    <!-- الموعد: كان مكتوباً في الكود (يومياً 2 صباحاً) ولا سبيل لتغييره -->
                    <Label text="%settings.scheduleSection" styleClass="sub-label"/>

                    <GridPane fx:id="scheduleGrid" hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="%settings.backupFrequency" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="backupFrequencyCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="%settings.backupTime" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT"
                              GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Spinner fx:id="backupHourSpinner" editable="true" prefWidth="90.0"/>
                            <Label text="%settings.timeSeparator"/>
                            <Spinner fx:id="backupMinuteSpinner" editable="true" prefWidth="90.0"/>
                        </HBox>

                        <Label fx:id="backupDayOfWeekLabel" text="%settings.backupDayOfWeek" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="backupDayOfWeekCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label fx:id="backupDayOfMonthLabel" text="%settings.backupDayOfMonth" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Spinner fx:id="backupDayOfMonthSpinner" editable="true" prefWidth="90.0"
                                 GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="%settings.backupRetention" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Spinner fx:id="backupRetentionSpinner" editable="true" prefWidth="90.0"
                                 GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Label text="%settings.backupNextRun" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <Label fx:id="backupNextRunLabel" text="%common.empty" wrapText="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                        <Label text="%settings.backupLastRun" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                        <Label fx:id="backupLastRunLabel" text="%common.empty" wrapText="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                    </GridPane>

                    <Label text="%settings.backupNote" styleClass="muted-text" wrapText="true"/>
                    <Label text="%settings.backupRetentionNote" styleClass="muted-text" wrapText="true"/>

                    <Separator/>

                    <!-- التشفير: الملف يخرج من الجهاز على فلاشة أو إلى Drive -->
                    <Label text="%settings.encryptionSection" styleClass="sub-label"/>

                    <CheckBox fx:id="backupEncryptCheckBox" text="%settings.encryptBackups"/>

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="%settings.passphrase" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <PasswordField fx:id="backupPassphraseField" promptText="%settings.passphrasePrompt"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="%settings.passphraseConfirm" styleClass="sub-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <PasswordField fx:id="backupPassphraseConfirmField" promptText="%settings.passphrasePrompt"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </GridPane>

                    <Label text="%settings.encryptionNote" styleClass="muted-text" wrapText="true"/>
                    <Label text="%settings.encryptionWarning" styleClass="danger-text" wrapText="true"/>

                    <Separator/>

                    <HBox spacing="14.0">
                        <Button text="%settings.backupNow" onAction="#handleManualBackup" styleClass="btn-success"/>
                        <Button text="%settings.restore" onAction="#handleRestoreBackup" styleClass="btn-danger"/>
                    </HBox>

                    <Label text="%settings.restoreWarning" styleClass="danger-text" wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ============ دفتر الحسابات ============ -->
        <Tab text="%settings.tab.ledger">
            <VBox spacing="18.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="220.0"/>
                    </columnConstraints>

                    <Label text="%settings.ledgerStart" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="ledgerStartDatePicker" editable="false"
                                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                </GridPane>

                <Label text="%settings.ledgerNote" styleClass="muted-text" wrapText="true"/>

                <Label text="%settings.ledgerWarning" styleClass="danger-text" wrapText="true"/>

                <Separator/>

                <Button text="%settings.clearLedgerDate" onAction="#handleClearLedgerDate"
                        styleClass="btn-secondary"/>
            </VBox>
        </Tab>

        <!-- ============ معلومات النظام ============ -->
        <Tab text="%settings.tab.system">
            <VBox spacing="14.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <GridPane hgap="16.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="320.0" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="%settings.notificationChannel" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="notificationChannelLabel" text="%common.empty"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="%settings.database" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="databaseLabel" text="%common.empty"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="%settings.dbUser" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="dbUserLabel" text="%common.empty"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <Label text="%settings.systemNote" styleClass="muted-text" wrapText="true"/>
            </VBox>
        </Tab>
    </TabPane>

    <HBox spacing="14.0" alignment="CENTER_LEFT">
        <Button text="%settings.save" onAction="#handleSaveSettings" styleClass="btn-success"/>
        <Button text="%settings.reload" onAction="#handleReload" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text=""/>
    </HBox>
</VBox>
