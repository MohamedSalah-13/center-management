<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codejava.center.controller.SettingsController"
      styleClass="content-area">
    <padding><Insets top="28.0" bottom="24.0" left="30.0" right="30.0"/></padding>

    <Label text="%settings.title" styleClass="header-label"/>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- ============ بيانات السنتر ============ -->
        <Tab text="%settings.tab.center">
            <VBox spacing="18.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <Label text="%settings.centerNote" styleClass="muted-text" wrapText="true"/>

                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="320.0" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="120.0"/>
                    </columnConstraints>

                    <Label text="%settings.centerName" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="centerNameField" promptText="%settings.centerNamePrompt"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="%settings.centerPhone" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="centerPhoneField" promptText="%settings.centerPhonePrompt"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="%settings.logo" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="logoPathField" promptText="%settings.logoPrompt" editable="false"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Button text="%common.browse" onAction="#handleBrowseLogo" styleClass="btn-secondary"
                            GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                </GridPane>

                <HBox spacing="14.0" alignment="CENTER_RIGHT" styleClass="card">
                    <Label text="%settings.logoPreview" styleClass="sub-label"/>
                    <ImageView fx:id="logoImageView" fitHeight="90.0" preserveRatio="true"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- ============ اللغة ============ -->
        <Tab text="%settings.tab.language">
            <VBox spacing="18.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="220.0"/>
                    </columnConstraints>

                    <Label text="%settings.language" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="languageCombo" maxWidth="Infinity"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                </GridPane>

                <Label text="%settings.languageNote" styleClass="muted-text" wrapText="true"/>
            </VBox>
        </Tab>

        <!-- ============ الطباعة ============ -->
        <Tab text="%settings.tab.print">
            <VBox spacing="18.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="320.0" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="120.0"/>
                    </columnConstraints>

                    <Label text="%settings.printer" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="printerCombo" maxWidth="Infinity"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button text="%common.refresh" onAction="#handleRefreshPrinters" styleClass="btn-secondary"
                            GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                    <Label text="%settings.printMode" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="printModeCombo" maxWidth="Infinity"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="%settings.printTarget" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="printTargetLabel" text="%common.empty"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <Label fx:id="printerWarningLabel" styleClass="danger-text" wrapText="true"
                       visible="false" managed="false"/>

                <Label text="%settings.printModeNote" styleClass="muted-text" wrapText="true"/>
                <Label text="%settings.printNote" styleClass="muted-text" wrapText="true"/>

                <Separator/>

                <Button text="%settings.printTestPage" onAction="#handlePrintTestPage" styleClass="btn-secondary"/>
            </VBox>
        </Tab>

        <!-- ============ النسخ الاحتياطي ============ -->
        <Tab text="%settings.tab.backup">
            <VBox spacing="18.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="320.0" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="120.0"/>
                    </columnConstraints>

                    <Label text="%settings.backupPath" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="backupPathField" promptText="%settings.backupPathPrompt" editable="false"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button text="%common.browse" onAction="#handleBrowseBackupPath" styleClass="btn-secondary"
                            GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                    <CheckBox fx:id="autoBackupCheckBox" text="%settings.autoBackup"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>

                <Label text="%settings.backupNote" styleClass="muted-text" wrapText="true"/>

                <Separator/>

                <HBox spacing="14.0">
                    <Button text="%settings.backupNow" onAction="#handleManualBackup" styleClass="btn-success"/>
                    <Button text="%settings.restore" onAction="#handleRestoreBackup" styleClass="btn-danger"/>
                </HBox>

                <Label text="%settings.restoreWarning" styleClass="danger-text" wrapText="true"/>
            </VBox>
        </Tab>

        <!-- ============ دفتر الحسابات ============ -->
        <Tab text="%settings.tab.ledger">
            <VBox spacing="18.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="220.0"/>
                    </columnConstraints>

                    <Label text="%settings.ledgerStart" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="ledgerStartDatePicker" editable="false"
                                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                </GridPane>

                <Label text="%settings.ledgerNote" styleClass="muted-text" wrapText="true"/>

                <Label text="%settings.ledgerWarning" styleClass="danger-text" wrapText="true"/>

                <Separator/>

                <Button text="%settings.clearLedgerDate" onAction="#handleClearLedgerDate"
                        styleClass="btn-secondary"/>
            </VBox>
        </Tab>

        <!-- ============ معلومات النظام ============ -->
        <Tab text="%settings.tab.system">
            <VBox spacing="14.0">
                <padding><Insets top="24.0" bottom="24.0" left="26.0" right="26.0"/></padding>

                <GridPane hgap="16.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180.0" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="320.0" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="%settings.notificationChannel" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="notificationChannelLabel" text="%common.empty"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="%settings.database" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="databaseLabel" text="%common.empty"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="%settings.dbUser" styleClass="sub-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="dbUserLabel" text="%common.empty"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <Label text="%settings.systemNote" styleClass="muted-text" wrapText="true"/>
            </VBox>
        </Tab>
    </TabPane>

    <HBox spacing="14.0" alignment="CENTER_LEFT">
        <Button text="%settings.save" onAction="#handleSaveSettings" styleClass="btn-success"/>
        <Button text="%settings.reload" onAction="#handleReload" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text=""/>
    </HBox>
</VBox>
