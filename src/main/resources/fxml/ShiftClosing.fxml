<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codejava.center.controller.ShiftClosingController"
      style="-fx-background-color: #f4f6f9; -fx-padding: 30;">

    <HBox spacing="20.0" alignment="CENTER_LEFT">
        <Label text="%shift.title" textFill="#2c3e50" style="-fx-font-size: 1.86em; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Label text="%shift.day" style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="dayPicker" editable="false" />
        <Button text="%shift.print" onAction="#handlePrint"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;" />
    </HBox>

    <!-- بطاقات الجرد -->
    <HBox spacing="20.0">
        <VBox styleClass="stat-card, card-green" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #27ae60; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="%shift.income" textFill="WHITE" style="-fx-font-size: 1.07em;" />
            <Label fx:id="incomeLabel" text="%common.empty" textFill="WHITE" style="-fx-font-size: 1.86em; -fx-font-weight: bold;" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #e74c3c; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="%shift.expenses" textFill="WHITE" style="-fx-font-size: 1.07em;" />
            <Label fx:id="expenseLabel" text="%common.empty" textFill="WHITE" style="-fx-font-size: 1.86em; -fx-font-weight: bold;" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #e67e22; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="%shift.payouts" textFill="WHITE" style="-fx-font-size: 1.07em;" />
            <Label fx:id="payoutLabel" text="%common.empty" textFill="WHITE" style="-fx-font-size: 1.86em; -fx-font-weight: bold;" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="%shift.net" textFill="WHITE" style="-fx-font-size: 1.07em;" />
            <Label fx:id="netLabel" text="%common.empty" textFill="WHITE" style="-fx-font-size: 1.86em; -fx-font-weight: bold;" />
        </VBox>
    </HBox>

    <Label text="%shift.note" textFill="#7f8c8d" wrapText="true" />

    <TableView fx:id="movementsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTime" text="%shift.col.time" prefWidth="110.0" />
            <TableColumn fx:id="colType" text="%shift.col.type" prefWidth="150.0" />
            <TableColumn fx:id="colAmount" text="%shift.col.amount" prefWidth="120.0" />
            <TableColumn fx:id="colStudent" text="%shift.col.student" prefWidth="180.0" />
            <TableColumn fx:id="colDescription" text="%shift.col.description" prefWidth="360.0" />
        </columns>
    </TableView>
</VBox>
